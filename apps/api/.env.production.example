# Production settings for the API. Copy to apps/api/.env on the server; never commit the real file.
NODE_ENV=production
PORT=4000
API_PREFIX=api

# PostgreSQL 15+. connection_limit=10 per process x 2 PM2 instances = 20 connections max (Task 66)
DATABASE_URL="postgresql://taxbros:CHANGE_ME@127.0.0.1:5432/taxbros?schema=public&connection_limit=10&pool_timeout=20"

# Two different 256-bit random secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The API refuses to start with missing, short or example values.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# Exact web origin(s), https only, comma-separated (Task 70)
CORS_ORIGIN="https://DOMAIN"

# Behind Nginx on the same machine: trust one proxy hop so rate limits see real client IPs
TRUST_PROXY=1

# Rate limits (Task 61). Raise LOGIN_RATE_LIMIT if a whole class signs in from one network.
USER_RATE_LIMIT=100
IP_RATE_LIMIT=500
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MINUTES=15

# Logs (Task 60)
LOG_DIR=./logs
LOG_LEVEL=info
LOG_RETENTION=90d

# API docs at /api/docs are off in production unless set to true
SWAGGER_ENABLED=false

MAX_FILE_SIZE=2097152
UPLOAD_PATH="./uploads"
INSTITUTE_TIMEZONE="Asia/Kolkata"
