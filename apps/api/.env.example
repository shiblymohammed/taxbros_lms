# Database Configuration
# Connection pooling limit of 10 is appropriate for development
# Format: postgresql://username:password@host:port/database?schema=public&connection_limit=10
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/taxbros_lms?schema=public&connection_limit=10"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production-minimum-256-bits"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-change-in-production-minimum-256-bits"
JWT_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# Application Configuration
NODE_ENV="development"
PORT=3001
API_PREFIX="api"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# Rate Limiting (R38). Defaults shown; all optional.
# Per authenticated user, per minute
USER_RATE_LIMIT=100
# Per client IP, per minute
IP_RATE_LIMIT=500
# Login attempts per client IP within the window. A classroom sharing one public IP
# may need a higher value.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MINUTES=15
# Set when running behind Nginx/a load balancer so real client IPs are used (e.g. 1)
# TRUST_PROXY=1

# Logging (R39). JSON files rotate daily: combined-*.log and error-*.log
LOG_DIR="./logs"
LOG_LEVEL="info"
LOG_RETENTION="90d"
# LOG_TO_FILES=false

# File Upload
MAX_FILE_SIZE=2097152
UPLOAD_PATH="./uploads"

# Institute Settings
# The institute timezone is now an admin setting (Settings screen, default Asia/Kolkata); this variable is no longer read.
