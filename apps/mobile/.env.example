# TAXBROS LMS Android app (Capacitor). Set before `npx cap sync android`; see README.md.

# The hosted web app the Android app opens (must be https in production)
CAP_SERVER_URL="https://lms.example.in"

# Android package ID. Decide once: it can't change after the app is published.
CAP_APP_ID="in.taxbros.lms"
