{
  "name": "mobile",
  "version": "1.0.0",
  "description": "TAXBROS LMS Android Application (Capacitor)",
  "private": true,
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
    "assets": "capacitor-assets generate --android --iconBackgroundColor #ffffff --splashBackgroundColor #ffffff",
    "build:apk": "cd android && gradlew.bat assembleRelease",
    "build:apk:debug": "cd android && gradlew.bat assembleDebug",
    "build": "echo \"Android: run sync, then build:apk (see README)\"",
    "dev": "echo \"Set CAP_SERVER_URL=http://10.0.2.2:3000 and run sync + open (see README)\"",
    "test": "echo \"No mobile unit tests: the app wraps the web app (tested in apps/web)\""
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "typescript": "^5.9.3"
  }
}
