# Copy to keystore.properties (git-ignored) and fill in. Never commit the real file or the keystore.
# Create the keystore once with (JDK keytool, e.g. from Android Studio's jbr/bin):
#   keytool -genkeypair -v -keystore taxbros-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias taxbros
storeFile=taxbros-release.jks
storePassword=
keyAlias=taxbros
keyPassword=
