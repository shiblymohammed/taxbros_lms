# TAXBROS LMS web app. Copy to .env.local (development) or set at build time (production).
# NEXT_PUBLIC_* values are built into the browser bundle: rebuild after changing them.

# API base URL, including /api
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
# Production example: NEXT_PUBLIC_API_URL="https://lms.example.in/api"

# Register the PWA service worker under `next dev` too (production always registers it)
NEXT_PUBLIC_ENABLE_SW="false"
